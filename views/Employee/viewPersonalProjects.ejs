<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_employee', { activePage: 'projects' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'My Projects', userName, csrfToken, profileUrl: '/employee/view-profile', userRole: 'Employee' }) %>
    <div class="p-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">My Projects</h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;"><%= typeof projects !== 'undefined' ? projects.length : 0 %> project<%= (typeof projects !== 'undefined' && projects.length !== 1) ? 's' : '' %> assigned</p>
        </div>
      </div>
      <div class="card">
        <div class="card-body">
          <% if (typeof hasProject !== 'undefined' && hasProject === 1 && projects && projects.length > 0) { %>
          <table class="table table-hover dt-table mb-0">
            <thead><tr><th>Title</th><th>Type</th><th>Status</th><th>Action</th></tr></thead>
            <tbody>
              <% projects.forEach(function(item) { %>
              <tr>
                <td style="font-weight:600;"><%= item.title %></td>
                <td style="font-size:0.85rem;"><%= item.type %></td>
                <td><% if(item.status === 'Finished') { %><span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Finished</span><% } else { %><span class="badge" style="background:#EFF6FF;color:#2490EF;border-radius:20px;padding:4px 10px;">Ongoing</span><% } %></td>
                <td><a href="/employee/view-project/<%= item._id %>" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-eye"></i></a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;"><i class="fa-solid fa-diagram-project fa-3x mb-3 d-block"></i><p>No projects assigned to you yet.</p></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>