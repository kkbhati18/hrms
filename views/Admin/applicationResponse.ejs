<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'leaves' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Leave Application', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="p-4">
      <div class="mb-4">
        <a href="/admin/leave-applications" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back to Applications</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Leave Application Details</h5>
      </div>
      <div class="row g-4">
        <div class="col-md-5">
          <div class="card">
            <div class="card-body">
              <h6 style="font-weight:700;margin-bottom:1rem;color:#374151;">Applicant Info</h6>
              <div class="d-flex align-items-center gap-3 mb-3">
                <div style="width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#22C55E,#16A34A);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.2rem;font-weight:700;"><%= employee.name ? employee.name[0].toUpperCase() : 'E' %></div>
                <div><div style="font-weight:600;"><%= employee.name %></div><div style="font-size:0.83rem;color:#6b7280;"><%= employee.email %></div></div>
              </div>
              <div class="row g-2">
                <div class="col-6"><div style="font-size:0.78rem;color:#9ca3af;">Title</div><div style="font-weight:600;font-size:0.9rem;"><%= leave.title %></div></div>
                <div class="col-6"><div style="font-size:0.78rem;color:#9ca3af;">Type</div><div style="font-weight:600;font-size:0.9rem;"><%= leave.type %></div></div>
                <div class="col-6"><div style="font-size:0.78rem;color:#9ca3af;">Period</div><div style="font-weight:600;font-size:0.9rem;"><%= leave.period %> days</div></div>
                <div class="col-6"><div style="font-size:0.78rem;color:#9ca3af;">Applied</div><div style="font-weight:600;font-size:0.9rem;"><%= moment(leave.appliedDate).format('DD MMM YYYY') %></div></div>
                <div class="col-6"><div style="font-size:0.78rem;color:#9ca3af;">Start Date</div><div style="font-weight:600;font-size:0.9rem;"><%= moment(leave.startDate).format('DD MMM YYYY') %></div></div>
                <div class="col-6"><div style="font-size:0.78rem;color:#9ca3af;">End Date</div><div style="font-weight:600;font-size:0.9rem;"><%= moment(leave.end_date).format('DD MMM YYYY') %></div></div>
              </div>
              <% if(leave.reason) { %>
              <div class="mt-3"><div style="font-size:0.78rem;color:#9ca3af;margin-bottom:4px;">Reason</div><p style="font-size:0.9rem;color:#374151;background:#F9FAFB;border-radius:8px;padding:10px;"><%= leave.reason %></p></div>
              <% } %>
            </div>
          </div>
        </div>
        <div class="col-md-7">
          <div class="card">
            <div class="card-body">
              <h6 style="font-weight:700;margin-bottom:1rem;color:#374151;">Respond to Application</h6>
              <form method="post" action="/admin/respond-application">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="leaveID" value="<%= leave._id %>" />
                <input type="hidden" name="employeeID" value="<%= employee._id %>" />
                <div class="mb-3">
                  <label class="form-label">Current Status</label>
                  <select name="status" class="form-select">
                    <option value="Pending" <%= leave.adminResponse === 'Pending' ? 'selected' : '' %>>Pending</option>
                    <option value="Approved" <%= leave.adminResponse === 'Approved' ? 'selected' : '' %>>Approved</option>
                    <option value="Disapproved" <%= leave.adminResponse === 'Disapproved' ? 'selected' : '' %>>Disapproved</option>
                  </select>
                </div>
                <div class="d-flex gap-2 mt-4">
                  <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-2"></i>Submit Response</button>
                  <a href="/admin/leave-applications" class="btn btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>