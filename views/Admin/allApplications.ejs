<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'leaves' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Leave Applications', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="p-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h5 style="font-weight:700;margin:0;color:#1a202c;">Leave Applications</h5>
      </div>
      <div class="card">
        <div class="card-body">
          <% if (hasLeave === 1) { %>
          <table class="table table-hover dt-table mb-0">
            <thead>
              <tr><th>Applicant</th><th>Title</th><th>Type</th><th>Applied Date</th><th>Period</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
              <% for (var i = 0; i < leaves.length; i++) { %>
              <tr>
                <td><div style="font-weight:600;font-size:0.9rem;"><%= employees[i] ? employees[i].name : 'Unknown' %></div><div style="font-size:0.75rem;color:#9ca3af;"><%= employees[i] ? employees[i].email : '' %></div></td>
                <td style="font-size:0.85rem;"><%= leaves[i].title %></td>
                <td><span class="badge bg-secondary bg-opacity-10 text-dark" style="border-radius:20px;font-size:0.75rem;"><%= leaves[i].type %></span></td>
                <td style="font-size:0.83rem;color:#6b7280;"><%= moment(leaves[i].appliedDate).format('DD MMM YYYY') %></td>
                <td style="font-weight:600;text-align:center;"><%= leaves[i].period %> days</td>
                <td>
                  <% if(leaves[i].adminResponse === 'Approved') { %><span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Approved</span>
                  <% } else if(leaves[i].adminResponse === 'Disapproved') { %><span class="badge" style="background:#FFF1F2;color:#F43F5E;border-radius:20px;padding:4px 10px;">Disapproved</span>
                  <% } else { %><span class="badge" style="background:#FFF7ED;color:#F97316;border-radius:20px;padding:4px 10px;">Pending</span><% } %>
                </td>
                <td><a href="/admin/respond-application/<%= leaves[i]._id %>/<%= employees[i] ? employees[i]._id : '' %>" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-reply me-1"></i>Respond</a></td>
              </tr>
              <% } %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;"><i class="fa-solid fa-inbox fa-3x mb-3 d-block"></i><p>No leave applications found.</p></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>