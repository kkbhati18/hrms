<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'home' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Dashboard', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: userRole }) %>

    <div class="page-inner">
      <!-- Welcome Banner -->
      <div class="section-card mb-4" style="background:linear-gradient(135deg,#6366f1,#2490EF);border:none;">
        <div class="section-card-body" style="padding:24px 28px;">
          <h4 style="color:#fff;font-weight:700;margin:0;">Welcome, <%= userName %>! 👋</h4>
          <p style="color:rgba(255,255,255,0.8);margin:6px 0 0;font-size:0.9rem;">Manage your team, projects, payroll and performance from here.</p>
        </div>
      </div>

      <!-- Stats -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div><div class="stat-value"><%= teamCount || 0 %></div><div class="stat-label">Team Members</div></div>
              <div class="stat-icon" style="background:#EBF5FF;color:#2490EF;"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="stat-change text-primary"><i class="fa-solid fa-user-check me-1"></i>Active</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div><div class="stat-value"><%= pendingLeaves || 0 %></div><div class="stat-label">Leave Requests</div></div>
              <div class="stat-icon" style="background:#FFF7ED;color:#F97316;"><i class="fa-solid fa-calendar-xmark"></i></div>
            </div>
            <div class="stat-change text-warning"><i class="fa-solid fa-clock me-1"></i>Pending</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div><div class="stat-value"><%= projectCount || 0 %></div><div class="stat-label">Projects</div></div>
              <div class="stat-icon" style="background:#FAF5FF;color:#A855F7;"><i class="fa-solid fa-diagram-project"></i></div>
            </div>
            <div class="stat-change" style="color:#A855F7;"><i class="fa-solid fa-layer-group me-1"></i>Assigned</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div><div class="stat-value"><%= appraisalCount || 0 %></div><div class="stat-label">Appraisals</div></div>
              <div class="stat-icon" style="background:#FFFBEB;color:#EAB308;"><i class="fa-solid fa-star-half-stroke"></i></div>
            </div>
            <div class="stat-change" style="color:#EAB308;"><i class="fa-solid fa-check me-1"></i>Completed</div>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <!-- Quick Actions -->
        <div class="col-md-4">
          <div class="section-card">
            <div class="section-card-header"><h6><i class="fa-solid fa-bolt me-2 text-primary"></i>Quick Actions</h6></div>
            <div class="section-card-body p-3">
              <div class="d-grid gap-2">
                <a href="/manager/view-employees" class="btn btn-primary btn-sm"><i class="fa-solid fa-users me-2"></i>View Team</a>
                <a href="/manager/applied-leaves" class="btn btn-outline-warning btn-sm"><i class="fa-solid fa-calendar-xmark me-2"></i>Review Leaves</a>
                <a href="/manager/view-attendance" class="btn btn-outline-success btn-sm"><i class="fa-solid fa-calendar-check me-2"></i>My Attendance</a>
                <a href="/manager/performance-appraisal" class="btn btn-outline-info btn-sm"><i class="fa-solid fa-star-half-stroke me-2"></i>Appraise Team</a>
                <a href="/manager/generate-payslip" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Generate Payslip</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Module Cards -->
        <div class="col-md-8">
          <div class="section-card">
            <div class="section-card-header"><h6><i class="fa-solid fa-grid-2 me-2 text-primary"></i>Manager Modules</h6></div>
            <div class="section-card-body p-3">
              <div class="row g-3">
                <div class="col-6">
                  <a href="/manager/view-employees" class="module-card">
                    <div class="module-icon" style="background:#EBF5FF;color:#2490EF;"><i class="fa-solid fa-users"></i></div>
                    <div class="module-title">Team Management</div>
                    <div class="module-desc">View & manage team</div>
                  </a>
                </div>
                <div class="col-6">
                  <a href="/manager/applied-leaves" class="module-card">
                    <div class="module-icon" style="background:#FFF7ED;color:#F97316;"><i class="fa-solid fa-calendar-xmark"></i></div>
                    <div class="module-title">Leave Requests</div>
                    <div class="module-desc">Approve / reject</div>
                  </a>
                </div>
                <div class="col-6">
                  <a href="/manager/performance-appraisal" class="module-card">
                    <div class="module-icon" style="background:#FFFBEB;color:#EAB308;"><i class="fa-solid fa-star-half-stroke"></i></div>
                    <div class="module-title">Performance</div>
                    <div class="module-desc">Rate & review team</div>
                  </a>
                </div>
                <div class="col-6">
                  <a href="/manager/generate-payslip" class="module-card">
                    <div class="module-icon" style="background:#ECFDF5;color:#10B981;"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                    <div class="module-title">Payroll</div>
                    <div class="module-desc">Generate payslips</div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
