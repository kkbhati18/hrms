<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'home' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Dashboard', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>

    <div class="page-inner">
      <!-- Welcome Banner -->
      <div class="section-card mb-4" style="background:linear-gradient(135deg,#2490EF,#6366f1);border:none;">
        <div class="section-card-body" style="padding:24px 28px;">
          <h4 style="color:#fff;font-weight:700;margin:0;">Welcome back, <%= userName %>! 👋</h4>
          <p style="color:rgba(255,255,255,0.8);margin:6px 0 0;font-size:0.9rem;">Here's what's happening in your organization today.</p>
        </div>
      </div>

      <!-- Stats Row -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="stat-value"><%= totalEmployees %></div>
                <div class="stat-label">Total Employees</div>
              </div>
              <div class="stat-icon" style="background:#EBF5FF;color:#2490EF;">
                <i class="fa-solid fa-users"></i>
              </div>
            </div>
            <div class="stat-change text-success"><i class="fa-solid fa-arrow-trend-up me-1"></i>Active Staff</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="stat-value"><%= pendingLeaves %></div>
                <div class="stat-label">Pending Leaves</div>
              </div>
              <div class="stat-icon" style="background:#FFF7ED;color:#F97316;">
                <i class="fa-solid fa-calendar-xmark"></i>
              </div>
            </div>
            <div class="stat-change text-warning"><i class="fa-solid fa-clock me-1"></i>Awaiting review</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="stat-value"><%= todayAttendance %></div>
                <div class="stat-label">Present Today</div>
              </div>
              <div class="stat-icon" style="background:#F0FDF4;color:#22C55E;">
                <i class="fa-solid fa-calendar-check"></i>
              </div>
            </div>
            <div class="stat-change text-success"><i class="fa-solid fa-check me-1"></i>Marked today</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="d-flex align-items-start justify-content-between">
              <div>
                <div class="stat-value"><%= totalProjects %></div>
                <div class="stat-label">Active Projects</div>
              </div>
              <div class="stat-icon" style="background:#FAF5FF;color:#A855F7;">
                <i class="fa-solid fa-diagram-project"></i>
              </div>
            </div>
            <div class="stat-change text-purple" style="color:#A855F7;"><i class="fa-solid fa-layer-group me-1"></i>In progress</div>
          </div>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <!-- Quick Actions -->
        <div class="col-md-4">
          <div class="section-card h-100">
            <div class="section-card-header">
              <h6><i class="fa-solid fa-bolt me-2 text-primary"></i>Quick Actions</h6>
            </div>
            <div class="section-card-body p-3">
              <div class="d-grid gap-2">
                <a href="/admin/add-employee" class="btn btn-primary btn-sm">
                  <i class="fa-solid fa-user-plus me-2"></i>Add Employee
                </a>
                <a href="/admin/leave-applications" class="btn btn-outline-warning btn-sm">
                  <i class="fa-solid fa-calendar-xmark me-2"></i>Review Leaves (<%= pendingLeaves %>)
                </a>
                <a href="/admin/attendance" class="btn btn-outline-success btn-sm">
                  <i class="fa-solid fa-calendar-check me-2"></i>Mark Attendance
                </a>
                <a href="/admin/add-project" class="btn btn-outline-purple btn-sm" style="border-color:#A855F7;color:#A855F7;">
                  <i class="fa-solid fa-plus me-2"></i>New Project
                </a>
                <a href="/admin/holidays" class="btn btn-outline-info btn-sm">
                  <i class="fa-solid fa-umbrella-beach me-2"></i>Manage Holidays
                </a>
                <a href="/admin/recruitment" class="btn btn-outline-secondary btn-sm">
                  <i class="fa-solid fa-briefcase me-2"></i>Recruitment
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Employees -->
        <div class="col-md-8">
          <div class="section-card h-100">
            <div class="section-card-header">
              <h6><i class="fa-solid fa-user-clock me-2 text-primary"></i>Recent Employees</h6>
              <a href="/admin/view-all-employees" class="btn btn-sm btn-outline-primary" style="font-size:0.78rem;">View All</a>
            </div>
            <div class="section-card-body">
              <% if (recentEmployees.length > 0) { %>
              <table class="table table-modern mb-0">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Dept</th>
                    <th>Joined</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% recentEmployees.forEach(function(emp) { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#2490EF,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.8rem;flex-shrink:0;">
                          <%= emp.name.charAt(0).toUpperCase() %>
                        </div>
                        <span style="font-weight:500;"><%= emp.name %></span>
                      </div>
                    </td>
                    <td>
                      <% if(emp.type==='employee') { %><span class="badge bg-primary-subtle text-primary" style="background:#EBF5FF;">Employee</span>
                      <% } else if(emp.type==='project_manager') { %><span class="badge" style="background:#FAF5FF;color:#A855F7;">PM</span>
                      <% } else { %><span class="badge" style="background:#FFF7ED;color:#F97316;">Accounts</span><% } %>
                    </td>
                    <td><span style="color:#6b7280;font-size:0.82rem;"><%= emp.department || '—' %></span></td>
                    <td><span style="color:#6b7280;font-size:0.82rem;"><%= emp.dateAdded ? moment(emp.dateAdded).format('DD MMM YYYY') : '—' %></span></td>
                    <td><a href="/admin/employee-profile/<%= emp._id %>" class="btn btn-sm btn-outline-secondary" style="font-size:0.75rem;">View</a></td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
              <% } else { %>
              <div class="text-center py-4" style="color:#9ca3af;">
                <i class="fa-solid fa-users fa-2x mb-2 d-block"></i>No employees yet
              </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Module Cards -->
      <div class="row g-3">
        <div class="col-12"><h6 style="font-weight:700;color:#2d3748;">HR Modules</h6></div>
        <div class="col-6 col-md-2">
          <a href="/admin/view-all-employees" class="module-card">
            <div class="module-icon" style="background:#EBF5FF;color:#2490EF;"><i class="fa-solid fa-users"></i></div>
            <div class="module-title">Employees</div>
            <div class="module-desc">Manage staff</div>
          </a>
        </div>
        <div class="col-6 col-md-2">
          <a href="/admin/leave-applications" class="module-card">
            <div class="module-icon" style="background:#FFF7ED;color:#F97316;"><i class="fa-solid fa-calendar-xmark"></i></div>
            <div class="module-title">Leaves</div>
            <div class="module-desc">Review requests</div>
          </a>
        </div>
        <div class="col-6 col-md-2">
          <a href="/admin/attendance" class="module-card">
            <div class="module-icon" style="background:#F0FDF4;color:#22C55E;"><i class="fa-solid fa-calendar-check"></i></div>
            <div class="module-title">Attendance</div>
            <div class="module-desc">Track presence</div>
          </a>
        </div>
        <div class="col-6 col-md-2">
          <a href="/admin/view-all-projects" class="module-card">
            <div class="module-icon" style="background:#FAF5FF;color:#A855F7;"><i class="fa-solid fa-diagram-project"></i></div>
            <div class="module-title">Projects</div>
            <div class="module-desc">Manage work</div>
          </a>
        </div>
        <div class="col-6 col-md-2">
          <a href="/admin/holidays" class="module-card">
            <div class="module-icon" style="background:#ECFDF5;color:#10B981;"><i class="fa-solid fa-umbrella-beach"></i></div>
            <div class="module-title">Holidays</div>
            <div class="module-desc">Set holidays</div>
          </a>
        </div>
        <div class="col-6 col-md-2">
          <a href="/admin/recruitment" class="module-card">
            <div class="module-icon" style="background:#FFF1F2;color:#F43F5E;"><i class="fa-solid fa-briefcase"></i></div>
            <div class="module-title">Recruitment</div>
            <div class="module-desc">Hire talent</div>
          </a>
        </div>
      </div>
    </div><!-- /page-inner -->
  </div><!-- /main-content -->

  <%- include('../partials/scripts') %>
</body>
</html>