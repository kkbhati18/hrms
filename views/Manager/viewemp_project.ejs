<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'employees' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Team Members', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: 'Project Manager' }) %>
    <div class="p-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">Team Members</h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;"><%= users.length %> employee<%= users.length !== 1 ? 's' : '' %></p>
        </div>
      </div>
      <% if (errors === 1) { %>
      <div class="alert alert-warning border-0 mb-4" style="border-radius:10px;"><i class="fa-solid fa-triangle-exclamation me-2"></i>Performance appraisal has already been submitted for this employee.</div>
      <% } %>
      <div class="card">
        <div class="card-body">
          <table class="table table-hover dt-table mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Designation</th><th>Actions</th></tr></thead>
            <tbody>
              <% users.forEach(function(u) { %>
              <tr>
                <td><div class="d-flex align-items-center gap-2"><div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#2490EF,#1976D2);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.8rem;flex-shrink:0;"><%= u.name ? u.name[0].toUpperCase() : 'E' %></div><span style="font-weight:600;"><%= u.name %></span></div></td>
                <td style="font-size:0.85rem;"><%= u.email %></td>
                <td><%= u.department || 'N/A' %></td>
                <td><%= u.designation || 'N/A' %></td>
                <td>
                  <a href="/manager/all-employee-skills/<%= u._id %>" class="btn btn-sm btn-outline-info me-1" title="Skills"><i class="fa-solid fa-star"></i></a>
                  <a href="/manager/all-employee-projects/<%= u._id %>" class="btn btn-sm btn-outline-secondary me-1" title="Projects"><i class="fa-solid fa-diagram-project"></i></a>
                  <a href="/manager/provide-performance-appraisal/<%= u._id %>" class="btn btn-sm btn-outline-success" title="Appraisal"><i class="fa-solid fa-chart-line"></i></a>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>