<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'appraisal' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Performance Appraisal', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: 'Project Manager', errorMsg: (typeof message !== 'undefined' && message !== '' ? message : null) }) %>
    <div class="p-4">
      <div class="mb-4">
        <a href="/manager/view-employees" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Performance Appraisal: <%= employee.name %></h5>
      </div>
      <div class="card p-4" style="max-width:600px;">
        <form method="post" action="/manager/provide-performance-appraisal">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="employeeID" value="<%= employee._id %>" />
          <div class="mb-3 p-3" style="background:#F9FAFB;border-radius:10px;">
            <div style="font-weight:700;"><%= employee.name %></div>
            <div style="font-size:0.83rem;color:#6b7280;"><%= employee.email %></div>
          </div>
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Communication Skills *</label>
              <div class="d-flex gap-2">
                <% for(var i=1;i<=5;i++){ %><div class="form-check"><input class="form-check-input" type="radio" name="communication" value="<%= i %>" id="comm<%= i %>" required /><label class="form-check-label" for="comm<%= i %>"><%= i %></label></div><% } %>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Technical Skills *</label>
              <div class="d-flex gap-2">
                <% for(var i=1;i<=5;i++){ %><div class="form-check"><input class="form-check-input" type="radio" name="technical" value="<%= i %>" id="tech<%= i %>" required /><label class="form-check-label" for="tech<%= i %>"><%= i %></label></div><% } %>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Teamwork *</label>
              <div class="d-flex gap-2">
                <% for(var i=1;i<=5;i++){ %><div class="form-check"><input class="form-check-input" type="radio" name="teamWork" value="<%= i %>" id="team<%= i %>" required /><label class="form-check-label" for="team<%= i %>"><%= i %></label></div><% } %>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Leadership *</label>
              <div class="d-flex gap-2">
                <% for(var i=1;i<=5;i++){ %><div class="form-check"><input class="form-check-input" type="radio" name="leadership" value="<%= i %>" id="lead<%= i %>" required /><label class="form-check-label" for="lead<%= i %>"><%= i %></label></div><% } %>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label">Comments</label>
              <textarea name="comments" class="form-control" rows="3" placeholder="Additional comments..."></textarea>
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-2"></i>Submit Appraisal</button>
              <a href="/manager/view-employees" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>