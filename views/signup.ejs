<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up | HRMS</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>

<body class="bg-white min-vh-100">
  <div class="container-fluid p-0">
    <div class="row g-0 min-vh-100">
      <!-- Left Panel -->
      <div class="col-lg-6 d-none d-lg-flex flex-column text-white position-relative"
        style="background-color: #0F172A;">
        <div class="flex-grow-1" style="background: url('/images/cover.jpg') center/cover no-repeat; height: 60%;">
        </div>
        <div class="p-5 d-flex flex-column justify-content-center" style="height: 40%;">
          <div class="d-flex align-items-center gap-2 mb-4">
            <div
              class="bg-success bg-opacity-25 text-success rounded-2 d-flex align-items-center justify-content-center fw-bold"
              style="width: 32px; height: 32px;">H</div>
            <span class="fw-bold fs-5 text-success">HRDashboard</span>
          </div>
          <h1 class="display-5 fw-bold mb-3">Let’s empower your<br>employees today.</h1>
          <p class="text-secondary fs-5">We help to complete all your conveyancing needs easily</p>
        </div>
        <div class="p-4 text-secondary small">
          © 2025 HRDashboard . Alright reserved.
        </div>
      </div>

      <!-- Right Panel -->
      <div class="col-lg-6 p-4 p-md-5 d-flex align-items-center justify-content-center position-relative bg-white">
        <div class="w-100" style="max-width: 450px;">
          <div class="text-center mb-4 d-lg-none">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-4">
              <div
                class="bg-success bg-opacity-25 text-success rounded-2 d-flex align-items-center justify-content-center fw-bold"
                style="width: 32px; height: 32px;">H</div>
              <span class="fw-bold fs-5 text-success">HRDashboard</span>
            </div>
          </div>

          <h2 class="h3 fw-bold text-center mb-5 mt-4">Create Account</h2>

          <% if (hasErrors) { %>
            <div class="alert alert-danger border-0 small py-2 mb-4 rounded-3">
              <i class="fa-solid fa-circle-exclamation me-2"></i>
              <%= messages[0] %>
            </div>
            <% } %>

              <form method="post" action="/signup">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

                <div class="mb-3">
                  <label class="form-label fw-medium text-secondary small">Full Name*</label>
                  <input type="text" name="name" class="form-control bg-light border-0 py-2 px-3 rounded-3 shadow-none"
                    placeholder="John Doe" required>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-medium text-secondary small">Email Address*</label>
                  <input type="email" name="email"
                    class="form-control bg-light border-0 py-2 px-3 rounded-3 shadow-none" placeholder="you@example.com"
                    required>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-medium text-secondary small">Password*</label>
                  <input type="password" name="password"
                    class="form-control bg-light border-0 py-2 px-3 rounded-3 shadow-none" placeholder="••••••••"
                    required>
                </div>

                <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold rounded-3 mb-4"
                  style="background-color: #0F172A; border: none;">Create Account</button>
              </form>

              <p class="text-center text-secondary small">
                Already have an account? <a href="/" class="text-success text-decoration-none fw-bold">Login</a>
              </p>

              <div
                class="position-absolute bottom-0 start-0 end-0 p-4 d-none d-lg-flex justify-content-end gap-3 text-secondary small">
                <a href="#" class="text-secondary text-decoration-none">Terms & Conditions</a>
                <a href="#" class="text-secondary text-decoration-none">Privacy Policy</a>
              </div>
        </div>
      </div>
    </div>
  </div>
</body>

</html>