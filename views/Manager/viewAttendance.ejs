<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'attendance' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'My Attendance', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: 'Manager' }) %>
    <div class="page-inner">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">My Attendance Sheet</h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;">Attendance records for the selected period</p>
        </div>
        <form method="post" action="/manager/view-attendance" class="d-flex gap-2 align-items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div>
            <label class="form-label mb-1" style="font-size:0.78rem;">Month</label>
            <select name="month" class="form-select form-select-sm" style="width:130px;">
              <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(function(m,i){ %><option value="<%= i+1 %>" <%= (typeof month !== 'undefined' && parseInt(month) === i+1) ? 'selected' : '' %>><%= m %></option><% }); %>
            </select>
          </div>
          <div>
            <label class="form-label mb-1" style="font-size:0.78rem;">Year</label>
            <select name="year" class="form-select form-select-sm" style="width:90px;" id="yearSelect"></select>
          </div>
          <button type="submit" class="btn btn-primary btn-sm">View</button>
        </form>
      </div>
      <div class="section-card">
        <div class="section-card-body">
          <% if (found === 1 && attendance && attendance.length > 0) { %>
          <table class="table table-modern dt-table mb-0">
            <thead><tr><th>#</th><th>Date</th><th>Status</th></tr></thead>
            <tbody>
              <% attendance.forEach(function(item, idx) { %>
              <tr>
                <td style="color:#9ca3af;font-size:0.83rem;"><%= idx+1 %></td>
                <td style="font-weight:500;"><%= moment(item.month + '/' + item.date + '/' + item.year).format('DD MMM YYYY') %></td>
                <td><span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Present</span></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;"><i class="fa-solid fa-calendar-xmark fa-3x mb-3 d-block"></i><p>No attendance found for the selected period.</p></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
  <script>
    (function(){
      var sel = document.getElementById('yearSelect');
      for(var y = new Date().getFullYear(); y > 1950; y--) {
        var o = document.createElement('option'); o.value = y; o.textContent = y; sel.appendChild(o);
      }
    })();
  </script>
</body>
</html>