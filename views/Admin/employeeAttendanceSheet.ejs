<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'attendance' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Employee Attendance', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="p-4">
      <div class="mb-4">
        <a href="/admin/view-all-employees" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Attendance: <%= employee_name %></h5>
      </div>
      <div class="card">
        <div class="card-body">
          <div class="d-flex align-items-center gap-3 mb-4">
            <div style="width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#22C55E,#16A34A);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.2rem;font-weight:700;"><%= employee_name ? employee_name[0].toUpperCase() : 'E' %></div>
            <div><div style="font-weight:700;font-size:1rem;"><%= employee_name %></div><div style="font-size:0.83rem;color:#6b7280;"><%= attendance && attendance.length > 0 ? attendance.length + ' days present' : 'No records found' %></div></div>
          </div>
          <% if (found === 1 && attendance && attendance.length > 0) { %>
          <table class="table table-hover dt-table mb-0">
            <thead><tr><th>#</th><th>Date</th><th>Status</th></tr></thead>
            <tbody>
              <% attendance.forEach(function(item, idx) { %>
              <tr>
                <td style="color:#9ca3af;font-size:0.83rem;"><%= idx+1 %></td>
                <td style="font-weight:500;"><%= moment(item.month + '/' + item.date + '/' + item.year).format('DD MMM YYYY') %></td>
                <td><span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Present</span></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;"><i class="fa-solid fa-calendar-xmark fa-3x mb-3 d-block"></i><p>No attendance records found for <%= employee_name %>.</p></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>