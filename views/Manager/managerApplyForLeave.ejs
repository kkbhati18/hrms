<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'apply-leave' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Apply for Leave', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: 'Manager' }) %>
    <div class="p-4">
      <div class="mb-4">
        <a href="/manager/applied-leaves" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Apply for Leave</h5>
      </div>
      <div class="card p-4" style="max-width:600px;">
        <form method="post" action="/manager/apply-for-leave">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="row g-3">
            <div class="col-12"><label class="form-label">Leave Title *</label><input type="text" name="title" class="form-control" required placeholder="Brief title" /></div>
            <div class="col-md-6">
              <label class="form-label">Leave Type *</label>
              <select name="type" class="form-select" required>
                <option>Sick Leave</option><option>Casual Leave</option><option>Annual Leave</option><option>Emergency Leave</option><option>Unpaid Leave</option>
              </select>
            </div>
            <div class="col-md-6"><label class="form-label">Period (Days) *</label><input type="number" name="period" class="form-control" required min="1" /></div>
            <div class="col-md-6"><label class="form-label">Start Date *</label><input type="date" name="start_date" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">End Date *</label><input type="date" name="end_date" class="form-control" required /></div>
            <div class="col-12"><label class="form-label">Reason *</label><textarea name="reason" class="form-control" rows="4" required placeholder="Explain your reason..."></textarea></div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-2"></i>Submit</button>
              <a href="/manager/applied-leaves" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>