<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'projects' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Add Project', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="p-4">
      <div class="mb-4">
        <a href="/admin/all-employee-projects/<%= employee._id %>" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Add Project for <%= employee.name %></h5>
      </div>
      <div class="card p-4" style="max-width:600px;">
        <form method="post" action="/admin/add-employee-project/<%= employee._id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Project Title *</label>
              <input type="text" name="title" class="form-control" required placeholder="Enter project title" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Type *</label>
              <input type="text" name="type" class="form-control" required placeholder="e.g. Web, Mobile" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Status</label>
              <select name="status" class="form-select">
                <option value="Ongoing">Ongoing</option>
                <option value="Finished">Finished</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Start Date *</label>
              <input type="date" name="start_date" class="form-control" required />
            </div>
            <div class="col-md-6">
              <label class="form-label">End Date *</label>
              <input type="date" name="end_date" class="form-control" required />
            </div>
            <div class="col-12">
              <label class="form-label">Description *</label>
              <textarea name="description" class="form-control" rows="4" required placeholder="Project description..."></textarea>
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Add Project</button>
              <a href="/admin/all-employee-projects/<%= employee._id %>" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>