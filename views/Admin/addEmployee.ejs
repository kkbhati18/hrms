<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'add-employee' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Add Employee', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="page-inner">
      <div class="mb-4">
        <a href="/admin/view-all-employees" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Add New Employee</h5>
      </div>
      <% if (hasErrors) { %>
      <div class="alert alert-danger border-0 mb-4" style="border-radius:10px;"><i class="fa-solid fa-circle-exclamation me-2"></i><% messages.forEach(function(msg) { %><%= msg %> <% }); %></div>
      <% } %>
      <div class="form-card" style="max-width:680px;">
        <form method="post" action="/admin/add-employee">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Full Name *</label>
              <input type="text" name="name" class="form-control" required value="<%= hasErrors && user.name ? user.name : '' %>" placeholder="Employee full name" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Email Address *</label>
              <input type="email" name="email" class="form-control" required value="<%= hasErrors && user.email ? user.email : '' %>" placeholder="email@company.com" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Date of Birth *</label>
              <input type="date" name="DOB" class="form-control" required value="<%= hasErrors && user.dateOfBirth ? new Date(user.dateOfBirth).toISOString().substring(0,10) : '' %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Password *</label>
              <input type="password" name="password" class="form-control" required minlength="6" placeholder="Min. 6 characters" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Contact Number</label>
              <input type="text" name="number" class="form-control" value="<%= hasErrors && user.contactNumber ? user.contactNumber : '' %>" placeholder="03XX-XXXXXXX" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Role *</label>
              <select name="type" class="form-select" required>
                <option value="employee">Employee</option>
                <option value="project_manager">Project Manager</option>
                <option value="accounts_manager">Accounts Manager</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Department</label>
              <select name="department" class="form-select">
                <option value="N/A">N/A</option>
                <option value="Human Resource">Human Resource</option>
                <option value="Software Development">Software Development</option>
                <option value="IT consulting">IT Consulting</option>
                <option value="Quality Assurance">Quality Assurance</option>
                <option value="Accounts">Accounts</option>
                <option value="Marketing">Marketing</option>
                <option value="Business Analysis">Business Analysis</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Designation</label>
              <select name="designation" class="form-select">
                <option value="N/A">N/A</option>
                <option value="System Analyst">System Analyst</option>
                <option value="Accounts Manager">Accounts Manager</option>
                <option value="Project Manager">Project Manager</option>
                <option value="Software Engineer">Software Engineer</option>
                <option value="Sr.Software Engineer">Sr. Software Engineer</option>
                <option value="Project Lead">Project Lead</option>
                <option value="Business Analyst">Business Analyst</option>
                <option value="Human Resource Manager">Human Resource Manager</option>
                <option value="Software Developer">Software Developer</option>
                <option value="Quality Analyst">Quality Analyst</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Skills</label>
              <select name="skills[]" class="form-select" multiple style="height:120px;">
                <option>Front End</option><option>ROR</option><option>.NET</option><option>PHP</option>
                <option>Python Django (ERP)</option><option>Mobile Development</option>
                <option>Big Data Analytics</option><option>Firmware</option>
              </select>
              <div class="form-text">Hold Ctrl / Cmd to select multiple</div>
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-user-plus me-2"></i>Add Employee</button>
              <a href="/admin/view-all-employees" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>