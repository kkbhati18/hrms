<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'projects' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Edit Project', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="page-inner">
      <div class="mb-4">
        <button onclick="history.go(-1)" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</button>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Edit Project</h5>
      </div>
      <div class="form-card" style="max-width:600px;">
        <form method="post" action="/admin/edit-employee-project/<%= project._id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Project Title *</label>
              <input type="text" name="title" class="form-control" required value="<%= project.title %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Type *</label>
              <input type="text" name="type" class="form-control" required value="<%= project.type %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Status</label>
              <select name="status" class="form-select">
                <option value="Ongoing" <%= project.status === 'Ongoing' ? 'selected' : '' %>>Ongoing</option>
                <option value="Finished" <%= project.status === 'Finished' ? 'selected' : '' %>>Finished</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Start Date *</label>
              <input type="date" name="start_date" class="form-control" required value="<%= new Date(project.startDate).toISOString().substring(0,10) %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">End Date *</label>
              <input type="date" name="end_date" class="form-control" required value="<%= new Date(project.endDate).toISOString().substring(0,10) %>" />
            </div>
            <div class="col-12">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control" rows="4"><%= project.description %></textarea>
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Save Changes</button>
              <button type="button" onclick="history.go(-1)" class="btn btn-outline-secondary">Cancel</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>