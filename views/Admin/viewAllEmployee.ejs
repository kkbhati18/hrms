<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'employees' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'All Employees', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="page-inner">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">All Employees</h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;"><%= users.length %> employee<%= users.length !== 1 ? 's' : '' %> registered</p>
        </div>
        <a href="/admin/add-employee" class="btn btn-primary btn-sm">
          <i class="fa-solid fa-plus me-2"></i>Add Employee
        </a>
      </div>
      <div class="section-card">
        <div class="section-card-body">
          <table class="table table-modern dt-table mb-0">
            <thead>
              <tr>
                <th>Name</th><th>Email</th><th>Contact</th><th>Department</th><th>Designation</th><th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function(item) { %>
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#2490EF,#1976D2);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.8rem;flex-shrink:0;"><%= item.name ? item.name[0].toUpperCase() : '?' %></div>
                    <div><div style="font-weight:600;font-size:0.9rem;"><%= item.name %></div><div style="font-size:0.75rem;color:#9ca3af;"><%= item.type %></div></div>
                  </div>
                </td>
                <td style="font-size:0.85rem;"><%= item.email %></td>
                <td style="font-size:0.85rem;"><%= item.contactNumber || '—' %></td>
                <td><%= item.department || 'N/A' %></td>
                <td><%= item.designation || 'N/A' %></td>
                <td>
                  <a href="/admin/employee-profile/<%= item._id %>" class="btn btn-sm btn-outline-secondary me-1" title="View"><i class="fa-solid fa-eye"></i></a>
                  <a href="/admin/edit-employee/<%= item._id %>" class="btn btn-sm btn-outline-primary me-1" title="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
                  <% if(item.type !== 'accounts_manager') { %>
                  <a href="/admin/add-employee-project/<%= item._id %>" class="btn btn-sm btn-outline-success me-1" title="Add Project"><i class="fa-solid fa-plus"></i></a>
                  <a href="/admin/all-employee-projects/<%= item._id %>" class="btn btn-sm btn-outline-info me-1" title="Projects"><i class="fa-solid fa-diagram-project"></i></a>
                  <% } %>
                  <button class="btn btn-sm btn-outline-danger delete-button" data-id="<%= item._id %>" title="Delete"><i class="fa-solid fa-trash"></i></button>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
      <div class="modal-content border-0" style="border-radius:16px;">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title" style="font-weight:700;">Delete Employee</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body"><p style="color:#6b7280;">Are you sure you want to delete this employee? This action cannot be undone.</p></div>
        <div class="modal-footer border-0">
          <form id="modal-delete-form" method="post" action="">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
  <script>
    document.querySelectorAll('.delete-button').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.getElementById('modal-delete-form').action = '/admin/delete-employee/' + this.getAttribute('data-id');
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
      });
    });
  </script>
</body>
</html>