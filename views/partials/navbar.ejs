<!-- Top Navbar: pass userName, pageTitle -->
<div class="bg-white border-bottom d-flex align-items-center px-4 gap-3 sticky-top" style="height:60px;z-index:1020;">
  <button class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:38px;height:38px;" id="sidebarToggle" title="Toggle Sidebar">
    <i class="fa-solid fa-bars"></i>
  </button>
  <span class="fw-semibold flex-grow-1"><%= typeof pageTitle !== 'undefined' ? pageTitle : title %></span>

  <!-- Notification Bell -->
  <button class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width:38px;height:38px;" title="Notifications">
    <i class="fa-solid fa-bell"></i>
  </button>

  <!-- User Dropdown -->
  <div class="dropdown">
    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold dropdown-toggle" style="width:36px;height:36px;font-size:0.85rem;cursor:pointer;" data-bs-toggle="dropdown" title="<%= userName %>">
      <%= userName ? userName.charAt(0).toUpperCase() : 'U' %>
    </div>
    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" style="min-width:200px;">
      <li class="px-3 py-2 border-bottom">
        <div style="font-weight:600;font-size:0.88rem;color:#2d3748;"><%= userName %></div>
        <div style="font-size:0.75rem;color:#6b7280;"><%= typeof userRole !== 'undefined' ? userRole : '' %></div>
      </li>
      <li><a class="dropdown-item" href="<%= typeof profileUrl !== 'undefined' ? profileUrl : '#' %>">
        <i class="fa-solid fa-circle-user me-2 text-primary"></i>My Profile</a></li>
      <li><hr class="dropdown-divider my-1"></li>
      <li>
        <form action="/logout" method="get" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="dropdown-item text-danger">
            <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
          </button>
        </form>
      </li>
    </ul>
  </div>
</div>

<!-- Toast container for flash messages -->
<div class="toast-container position-fixed end-0 p-3" style="z-index:9999;top:65px;">
  <% if (typeof successMsg !== 'undefined' && successMsg) { %>
  <div class="toast align-items-center text-bg-success border-0 show" role="alert">
    <div class="d-flex">
      <div class="toast-body"><i class="fa-solid fa-circle-check me-2"></i><%= successMsg %></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
  <% } %>
  <% if (typeof errorMsg !== 'undefined' && errorMsg) { %>
  <div class="toast align-items-center text-bg-danger border-0 show" role="alert">
    <div class="d-flex">
      <div class="toast-body"><i class="fa-solid fa-circle-exclamation me-2"></i><%= errorMsg %></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
  <% } %>
</div>

<script>
  (function () {
    const toggleSidebar = function () {
      const sidebar = document.getElementById('sidebar');
      const mainContent = document.getElementById('main-content');
      if (!sidebar || !mainContent) return;
      
      if (window.innerWidth <= 768) {
        sidebar.classList.toggle('show');
      } else {
        sidebar.classList.toggle('collapsed');
        mainContent.classList.toggle('collapsed');
      }
    };
    
    document.getElementById('sidebarToggle')?.addEventListener('click', toggleSidebar);
    document.getElementById('sidebarClose')?.addEventListener('click', toggleSidebar);
  })();
</script>
