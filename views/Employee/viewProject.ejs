<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_employee', { activePage: 'projects' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Project Details', userName, csrfToken, profileUrl: '/employee/view-profile', userRole: 'Employee' }) %>
    <div class="page-inner">
      <div class="mb-4">
        <a href="/employee/view-personal-projects" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Project Details</h5>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="section-card">
            <div class="section-card-body">
              <h6 style="font-weight:700;margin-bottom:1rem;color:#374151;">Overview</h6>
              <div class="row g-2">
                <div class="col-12"><div style="font-size:0.75rem;color:#9ca3af;">Type</div><div style="font-weight:600;font-size:0.9rem;"><%= project.type %></div></div>
                <div class="col-12"><div style="font-size:0.75rem;color:#9ca3af;">Status</div>
                  <% if(project.status === 'Finished') { %><span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;">Finished</span><% } else { %><span class="badge" style="background:#EFF6FF;color:#2490EF;border-radius:20px;">Ongoing</span><% } %>
                </div>
                <div class="col-12"><div style="font-size:0.75rem;color:#9ca3af;">Start Date</div><div style="font-weight:600;font-size:0.85rem;"><%= moment(project.startDate).format('DD MMM YYYY') %></div></div>
                <div class="col-12"><div style="font-size:0.75rem;color:#9ca3af;">End Date</div><div style="font-weight:600;font-size:0.85rem;"><%= moment(project.endDate).format('DD MMM YYYY') %></div></div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-8">
          <div class="section-card">
            <div class="section-card-body">
              <h5 style="font-weight:700;color:#1a202c;margin-bottom:0.5rem;"><%= project.title %></h5>
              <p style="color:#6b7280;font-size:0.9rem;line-height:1.6;"><%= project.description || 'No description provided.' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>