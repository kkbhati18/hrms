<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'leaves' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'My Leave Applications', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: 'Manager' }) %>
    <div class="page-inner">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h5 style="font-weight:700;margin:0;color:#1a202c;">My Leave Applications</h5>
        <a href="/manager/apply-for-leave" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-2"></i>Apply for Leave</a>
      </div>
      <div class="section-card">
        <div class="section-card-body">
          <% if (hasLeave === 1) { %>
          <table class="table table-modern dt-table mb-0">
            <thead><tr><th>Title</th><th>Type</th><th>Period</th><th>Status</th></tr></thead>
            <tbody>
              <% leaves.forEach(function(leave) { %>
              <tr>
                <td style="font-weight:600;"><%= leave.title %></td>
                <td><span class="badge bg-secondary bg-opacity-10 text-dark" style="border-radius:20px;font-size:0.75rem;"><%= leave.type %></span></td>
                <td style="font-weight:600;text-align:center;"><%= leave.period %> days</td>
                <td>
                  <% if(leave.adminResponse === 'Approved') { %><span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Approved</span>
                  <% } else if(leave.adminResponse === 'Disapproved') { %><span class="badge" style="background:#FFF1F2;color:#F43F5E;border-radius:20px;padding:4px 10px;">Disapproved</span>
                  <% } else { %><span class="badge" style="background:#FFF7ED;color:#F97316;border-radius:20px;padding:4px 10px;">Pending</span><% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;"><i class="fa-solid fa-inbox fa-3x mb-3 d-block"></i><p>No leave applications yet.</p></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>