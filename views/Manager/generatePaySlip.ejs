<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'payslip' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Generate Pay Slip', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: 'Accounts Manager' }) %>
    <div class="page-inner">
      <div class="mb-4">
        <a href="/manager/view-employees" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Generate Pay Slip: <%= employee.name %></h5>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="section-card text-center">
            <div class="section-card-body">
              <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#7C3AED,#5B21B6);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.5rem;font-weight:700;margin:0 auto 1rem;"><%= employee.name ? employee.name[0].toUpperCase() : 'E' %></div>
              <h6 style="font-weight:700;"><%= employee.name %></h6>
              <p style="color:#6b7280;font-size:0.85rem;margin:0;"><%= employee.designation || 'Employee' %></p>
            </div>
          </div>
        </div>
        <div class="col-md-8">
          <div class="form-card">
            <form method="post" action="/manager/generate-pay-slip">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input type="hidden" name="employee_id" value="<%= employee._id %>" />
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Bank Name *</label>
                  <input type="text" name="bname" class="form-control" required value="<%= hasPaySlip ? pay_slip.bankName : '' %>" placeholder="Bank name" />
                </div>
                <div class="col-md-6">
                  <label class="form-label">Branch Address *</label>
                  <input type="text" name="baddress" class="form-control" required value="<%= hasPaySlip ? pay_slip.branchAddress : '' %>" placeholder="Branch address" />
                </div>
                <div class="col-md-4">
                  <label class="form-label">Basic Pay (₹) *</label>
                  <input type="number" name="pay" class="form-control" required min="0" value="<%= hasPaySlip ? pay_slip.basicPay : 0 %>" />
                </div>
                <div class="col-md-4">
                  <label class="form-label">Overtime (₹)</label>
                  <input type="number" name="otime" class="form-control" min="0" value="<%= hasPaySlip ? pay_slip.overtime : 0 %>" />
                </div>
                <div class="col-md-4">
                  <label class="form-label">Conveyance Allowance (₹)</label>
                  <input type="number" name="allowance" class="form-control" min="0" value="<%= hasPaySlip ? pay_slip.conveyanceAllowance : 0 %>" />
                </div>
                <div class="col-12 d-flex gap-2">
                  <button type="submit" class="btn btn-primary"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Generate Pay Slip</button>
                  <a href="/manager/view-employees" class="btn btn-outline-secondary">Cancel</a>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>