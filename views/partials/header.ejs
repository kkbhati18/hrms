<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HRMS | <%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Font Awesome 6 -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
  <!-- DataTables Bootstrap 5 -->
  <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
  <style>
    /* ── Sidebar layout (structural only – everything else uses Bootstrap) ── */
    :root { --sidebar-width: 260px; }
    body { background: #f4f6f9; }

    #sidebar {
      width: var(--sidebar-width); position: fixed; top: 0; left: 0;
      min-height: 100vh; z-index: 1030; overflow-y: auto; overflow-x: hidden;
      transition: width 0.3s;
    }
    #main-content { margin-left: var(--sidebar-width); min-height: 100vh; transition: margin-left 0.3s; }
    #sidebar.collapsed { width: 0; overflow: hidden; }
    #main-content.collapsed { margin-left: 0; }

    /* Sidebar nav-link accent */
    .sidebar-nav .nav-item .nav-link {
      color: #adb5bd; padding: 9px 20px; display: flex; align-items: center;
      gap: 12px; font-size: 0.88rem; border-left: 3px solid transparent;
      transition: all 0.2s; white-space: nowrap;
    }
    .sidebar-nav .nav-item .nav-link:hover { background: rgba(255,255,255,0.08); color: #fff; }
    .sidebar-nav .nav-item .nav-link.active {
      background: rgba(36,144,239,0.18); color: #fff; border-left-color: #2490EF;
    }
    .sidebar-nav .nav-item .nav-link i { width: 18px; text-align: center; font-size: 0.9rem; }
    .sidebar-submenu { background: rgba(0,0,0,0.15); }
    .sidebar-submenu .nav-link { padding-left: 52px !important; font-size: 0.83rem; }

    @media (max-width: 768px) {
      #sidebar { width: 0; }
      #sidebar.show { width: var(--sidebar-width); }
      #main-content { margin-left: 0 !important; }
    }
  </style>
</head>