<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'home' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Dashboard', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: userRole }) %>

    <div class="p-4">
      <!-- Welcome Banner -->
      <div class="card mb-4" style="background:linear-gradient(135deg,#6366f1,#2490EF);border:none;">
        <div class="card-body" style="padding:24px 28px;">
          <h4 style="color:#fff;font-weight:700;margin:0;">Welcome, <%= userName %>! 👋</h4>
          <p style="color:rgba(255,255,255,0.8);margin:6px 0 0;font-size:0.9rem;">Manage your team, projects, payroll and performance from here.</p>
        </div>
      </div>

      <!-- Stats -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="card p-4 h-100">
            <div class="d-flex align-items-start justify-content-between">
              <div><div class="fs-2 fw-bold lh-1"><%= teamCount || 0 %></div><div class="small text-muted mt-1">Team Members</div></div>
              <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fs-5" style="width:48px;height:48px;background:#EBF5FF;color:#2490EF;"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="small mt-2 text-primary"><i class="fa-solid fa-user-check me-1"></i>Active</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card p-4 h-100">
            <div class="d-flex align-items-start justify-content-between">
              <div><div class="fs-2 fw-bold lh-1"><%= pendingLeaves || 0 %></div><div class="small text-muted mt-1">Leave Requests</div></div>
              <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fs-5" style="width:48px;height:48px;background:#FFF7ED;color:#F97316;"><i class="fa-solid fa-calendar-xmark"></i></div>
            </div>
            <div class="small mt-2 text-warning"><i class="fa-solid fa-clock me-1"></i>Pending</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card p-4 h-100">
            <div class="d-flex align-items-start justify-content-between">
              <div><div class="fs-2 fw-bold lh-1"><%= projectCount || 0 %></div><div class="small text-muted mt-1">Projects</div></div>
              <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fs-5" style="width:48px;height:48px;background:#FAF5FF;color:#A855F7;"><i class="fa-solid fa-diagram-project"></i></div>
            </div>
            <div class="small mt-2" style="color:#A855F7;"><i class="fa-solid fa-layer-group me-1"></i>Assigned</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card p-4 h-100">
            <div class="d-flex align-items-start justify-content-between">
              <div><div class="fs-2 fw-bold lh-1"><%= appraisalCount || 0 %></div><div class="small text-muted mt-1">Appraisals</div></div>
              <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 fs-5" style="width:48px;height:48px;background:#FFFBEB;color:#EAB308;"><i class="fa-solid fa-star-half-stroke"></i></div>
            </div>
            <div class="small mt-2" style="color:#EAB308;"><i class="fa-solid fa-check me-1"></i>Completed</div>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <!-- Quick Actions -->
        <div class="col-md-4">
          <div class="card">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="fa-solid fa-bolt me-2 text-primary"></i>Quick Actions</h6></div>
            <div class="card-body p-3">
              <div class="d-grid gap-2">
                <a href="/manager/view-employees" class="btn btn-primary btn-sm"><i class="fa-solid fa-users me-2"></i>View Team</a>
                <a href="/manager/applied-leaves" class="btn btn-outline-warning btn-sm"><i class="fa-solid fa-calendar-xmark me-2"></i>Review Leaves</a>
                <a href="/manager/view-attendance" class="btn btn-outline-success btn-sm"><i class="fa-solid fa-calendar-check me-2"></i>My Attendance</a>
                <a href="/manager/performance-appraisal" class="btn btn-outline-info btn-sm"><i class="fa-solid fa-star-half-stroke me-2"></i>Appraise Team</a>
                <a href="/manager/generate-payslip" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Generate Payslip</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Module Cards -->
        <div class="col-md-8">
          <div class="card">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="fa-solid fa-grid-2 me-2 text-primary"></i>Manager Modules</h6></div>
            <div class="card-body p-3">
              <div class="row g-3">
                <div class="col-6">
                  <a href="/manager/view-employees" class="card p-3 text-decoration-none link-body-emphasis h-100 d-flex flex-column gap-2">
                    <div class="rounded-3 d-flex align-items-center justify-content-center fs-5" style="width:44px;height:44px;background:#EBF5FF;color:#2490EF;"><i class="fa-solid fa-users"></i></div>
                    <div class="fw-semibold small">Team Management</div>
                    <div class="small text-muted">View &amp; manage team</div>
                  </a>
                </div>
                <div class="col-6">
                  <a href="/manager/applied-leaves" class="card p-3 text-decoration-none link-body-emphasis h-100 d-flex flex-column gap-2">
                    <div class="rounded-3 d-flex align-items-center justify-content-center fs-5" style="width:44px;height:44px;background:#FFF7ED;color:#F97316;"><i class="fa-solid fa-calendar-xmark"></i></div>
                    <div class="fw-semibold small">Leave Requests</div>
                    <div class="small text-muted">Approve / reject</div>
                  </a>
                </div>
                <div class="col-6">
                  <a href="/manager/performance-appraisal" class="card p-3 text-decoration-none link-body-emphasis h-100 d-flex flex-column gap-2">
                    <div class="rounded-3 d-flex align-items-center justify-content-center fs-5" style="width:44px;height:44px;background:#FFFBEB;color:#EAB308;"><i class="fa-solid fa-star-half-stroke"></i></div>
                    <div class="fw-semibold small">Performance</div>
                    <div class="small text-muted">Rate &amp; review team</div>
                  </a>
                </div>
                <div class="col-6">
                  <a href="/manager/generate-payslip" class="card p-3 text-decoration-none link-body-emphasis h-100 d-flex flex-column gap-2">
                    <div class="rounded-3 d-flex align-items-center justify-content-center fs-5" style="width:44px;height:44px;background:#ECFDF5;color:#10B981;"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                    <div class="fw-semibold small">Payroll</div>
                    <div class="small text-muted">Generate payslips</div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
