<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'employees' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Employee Salaries', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: 'Accounts Manager' }) %>
    <div class="p-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h5 style="font-weight:700;margin:0;color:#1a202c;">Employee Salaries</h5>
      </div>
      <div class="card">
        <div class="card-body">
          <table class="table table-hover dt-table mb-0">
            <thead><tr><th>Name</th><th>Email</th><th>Basic Pay</th><th>Overtime</th><th>Conveyance</th><th>Bonus</th><th>Actions</th></tr></thead>
            <tbody>
              <% for(var i = 0; i < users.length; i++) { %>
              <tr>
                <td><div class="d-flex align-items-center gap-2"><div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#7C3AED,#5B21B6);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:0.8rem;flex-shrink:0;"><%= users[i].name ? users[i].name[0].toUpperCase() : 'E' %></div><span style="font-weight:600;"><%= users[i].name %></span></div></td>
                <td style="font-size:0.85rem;"><%= users[i].email %></td>
                <td style="font-weight:600;">₹<%= salary[i] ? salary[i].basicPay.toLocaleString() : 0 %></td>
                <td>₹<%= salary[i] ? salary[i].overtime.toLocaleString() : 0 %></td>
                <td>₹<%= salary[i] ? salary[i].conveyanceAllowance.toLocaleString() : 0 %></td>
                <td>₹<%= salary[i] ? (salary[i].bonus || 0).toLocaleString() : 0 %></td>
                <td>
                  <a href="/manager/generate-pay-slip/<%= users[i]._id %>" class="btn btn-sm btn-outline-primary me-1" title="Payslip"><i class="fa-solid fa-file-invoice-dollar"></i></a>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <!-- Set Bonus Modal Trigger (per employee) can be added here -->
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>