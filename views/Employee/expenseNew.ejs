<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_employee', { activePage: 'new-expense' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'New Expense Claim', userName, csrfToken, profileUrl: '/employee/view-profile', userRole: 'Employee' }) %>

    <div class="page-inner">
      <div class="mb-4">
        <a href="/employee/expenses" class="btn btn-outline-secondary btn-sm me-2">
          <i class="fa-solid fa-arrow-left me-1"></i>Back
        </a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">File Expense Claim</h5>
      </div>

      <% if (error && error.length > 0) { %>
      <div class="alert alert-danger border-0 mb-4" style="border-radius:10px;">
        <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
      </div>
      <% } %>

      <div class="form-card" style="max-width:600px;">
        <form method="post" action="/employee/expenses/new">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Claim Title *</label>
              <input type="text" name="title" class="form-control" required placeholder="e.g. Client Meeting Travel" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Category *</label>
              <select name="category" class="form-select" required>
                <option value="">Select category</option>
                <option value="Travel">Travel</option>
                <option value="Accommodation">Accommodation</option>
                <option value="Food">Food & Beverages</option>
                <option value="Equipment">Equipment</option>
                <option value="Training">Training</option>
                <option value="Medical">Medical</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Amount (₹) *</label>
              <input type="number" name="amount" class="form-control" required min="1" placeholder="0.00" step="0.01" />
            </div>
            <div class="col-md-3">
              <label class="form-label">Expense Date *</label>
              <input type="date" name="expenseDate" class="form-control" required />
            </div>
            <div class="col-12">
              <label class="form-label">Description *</label>
              <textarea name="description" class="form-control" rows="3" required placeholder="Describe the expense and purpose..."></textarea>
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-2"></i>Submit Claim</button>
              <a href="/employee/expenses" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
