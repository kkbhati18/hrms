<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'add-project' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Add Project', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator', errorMsg: (typeof error !== 'undefined' ? error : null) }) %>

    <div class="p-4">
      <div class="mb-4">
        <a href="/admin/view-all-projects" class="btn btn-outline-secondary btn-sm me-2">
          <i class="fa-solid fa-arrow-left me-1"></i>Back to Projects
        </a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Create New Project</h5>
      </div>

      <div class="card p-4" style="max-width:680px;">
        <form method="post" action="/admin/add-project">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="row g-3">
            <div class="col-12">
              <label class="form-label">Project Name *</label>
              <input type="text" name="projectName" class="form-control" required placeholder="Enter project name" />
            </div>
            <div class="col-12">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control" rows="3" placeholder="Brief project description..."></textarea>
            </div>
            <div class="col-12">
              <label class="form-label">Assign Employees</label>
              <select name="employees" class="form-select" multiple style="height:160px;">
                <% employees.forEach(function(emp) { %>
                <option value="<%= emp._id %>"><%= emp.firstName %> <%= emp.lastName %> &mdash; <%= emp.position || emp.role %></option>
                <% }); %>
              </select>
              <div class="form-text">Hold Ctrl / Cmd to select multiple employees</div>
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Create Project</button>
              <a href="/admin/view-all-projects" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
