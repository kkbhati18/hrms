<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_manager', { activePage: 'employees' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Employee Skills', userName, csrfToken, profileUrl: '/manager/view-profile', userRole: 'Project Manager' }) %>
    <div class="page-inner">
      <div class="mb-4">
        <a href="/manager/view-employees" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Skills: <%= employee.name %></h5>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="section-card text-center">
            <div class="section-card-body">
              <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,#2490EF,#1976D2);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.5rem;font-weight:700;margin:0 auto 1rem;"><%= employee.name ? employee.name[0].toUpperCase() : 'E' %></div>
              <h6 style="font-weight:700;"><%= employee.name %></h6>
              <p style="color:#6b7280;font-size:0.85rem;"><%= employee.designation || 'N/A' %></p>
            </div>
          </div>
        </div>
        <div class="col-md-8">
          <div class="section-card">
            <div class="section-card-body">
              <h6 style="font-weight:700;margin-bottom:1rem;color:#374151;">Skills</h6>
              <% if(employee.Skills && employee.Skills.length > 0) { %>
              <div class="d-flex flex-wrap gap-2">
                <% employee.Skills.forEach(function(s){ if(s){ %><span class="badge" style="background:#EFF6FF;color:#2490EF;border-radius:20px;font-size:0.88rem;padding:6px 14px;"><%= s %></span><% } }); %>
              </div>
              <% } else { %>
              <p style="color:#9ca3af;">No skills listed for this employee.</p>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>