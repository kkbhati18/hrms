<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_employee', { activePage: 'expenses' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Expense Claims', userName, csrfToken, profileUrl: '/employee/view-profile', userRole: 'Employee' }) %>

    <div class="page-inner">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">My Expense Claims</h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;">Submit and track your reimbursement requests</p>
        </div>
        <a href="/employee/expenses/new" class="btn btn-primary btn-sm">
          <i class="fa-solid fa-plus me-2"></i>New Claim
        </a>
      </div>

      <!-- Summary Cards -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-value"><%= claims.length %></div>
            <div class="stat-label">Total Claims</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-value"><%= claims.filter(c=>c.status==='Pending').length %></div>
            <div class="stat-label">Pending</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-value">₹<%= claims.filter(c=>c.status==='Approved').reduce((s,c)=>s+c.amount,0).toLocaleString() %></div>
            <div class="stat-label">Approved Amount</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stat-card">
            <div class="stat-value"><%= claims.filter(c=>c.status==='Approved').length %></div>
            <div class="stat-label">Approved</div>
          </div>
        </div>
      </div>

      <div class="section-card">
        <div class="section-card-body">
          <% if (claims.length > 0) { %>
          <table class="table table-modern dt-table mb-0">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Expense Date</th>
                <th>Status</th>
                <th>Note</th>
              </tr>
            </thead>
            <tbody>
              <% claims.forEach(function(c) { %>
              <tr>
                <td style="font-weight:500;"><%= c.title %></td>
                <td><span class="badge bg-secondary bg-opacity-10 text-dark" style="border-radius:20px;font-size:0.75rem;"><%= c.category %></span></td>
                <td style="font-weight:600;">₹<%= c.amount.toLocaleString() %></td>
                <td style="font-size:0.83rem;color:#6b7280;"><%= moment(c.expenseDate).format('DD MMM YYYY') %></td>
                <td>
                  <% if(c.status==='Approved') { %>
                  <span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Approved</span>
                  <% } else if(c.status==='Rejected') { %>
                  <span class="badge" style="background:#FFF1F2;color:#F43F5E;border-radius:20px;padding:4px 10px;">Rejected</span>
                  <% } else { %>
                  <span class="badge" style="background:#FFF7ED;color:#F97316;border-radius:20px;padding:4px 10px;">Pending</span>
                  <% } %>
                </td>
                <td style="font-size:0.82rem;color:#6b7280;"><%= c.reviewNote || '—' %></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;">
            <i class="fa-solid fa-receipt fa-3x mb-3 d-block"></i>
            <p>No expense claims yet.</p>
            <a href="/employee/expenses/new" class="btn btn-primary btn-sm">File First Claim</a>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
