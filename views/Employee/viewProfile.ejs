<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_employee', { activePage: 'profile' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'My Profile', userName, csrfToken, profileUrl: '/employee/view-profile', userRole: 'Employee' }) %>
    <div class="p-4">
      <h5 style="font-weight:700;color:#1a202c;margin-bottom:1.5rem;">My Profile</h5>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card text-center">
            <div class="card-body">
              <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#22C55E,#16A34A);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.8rem;font-weight:700;margin:0 auto 1rem;"><%= employee.name ? employee.name[0].toUpperCase() : 'E' %></div>
              <h6 style="font-weight:700;margin:0;"><%= employee.name %></h6>
              <p style="color:#6b7280;font-size:0.85rem;margin:4px 0 8px;"><%= employee.designation || 'Employee' %></p>
              <span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;font-size:0.75rem;padding:5px 12px;"><%= employee.department || 'N/A' %></span>
              <div class="mt-3">
                <a href="/employee/applied-leaves" class="btn btn-outline-success btn-sm me-2"><i class="fa-solid fa-calendar me-1"></i>My Leaves</a>
                <a href="/employee/view-attendance" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-clock me-1"></i>Attendance</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-8">
          <div class="card">
            <div class="card-body">
              <h6 style="font-weight:700;margin-bottom:1rem;color:#374151;">Personal Information</h6>
              <div class="row g-3">
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Full Name</div><div style="font-weight:600;"><%= employee.name %></div></div>
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Email</div><div style="font-weight:600;word-break:break-all;"><%= employee.email %></div></div>
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Date of Birth</div><div style="font-weight:600;"><%= moment(employee.dateOfBirth).format('DD MMM YYYY') %></div></div>
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Contact</div><div style="font-weight:600;"><%= employee.contactNumber || 'N/A' %></div></div>
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Department</div><div style="font-weight:600;"><%= employee.department || 'N/A' %></div></div>
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Designation</div><div style="font-weight:600;"><%= employee.designation || 'N/A' %></div></div>
              </div>
              <% if(employee.Skills && employee.Skills.length > 0) { %>
              <hr style="margin:1.5rem 0;" />
              <h6 style="font-weight:700;margin-bottom:0.75rem;color:#374151;">Skills</h6>
              <div class="d-flex flex-wrap gap-2">
                <% employee.Skills.forEach(function(s){ if(s){ %><span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;font-size:0.8rem;padding:5px 12px;"><%= s %></span><% } }); %>
              </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>