<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'employees' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Edit Employee', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="page-inner">
      <div class="mb-4">
        <a href="/admin/view-all-employees" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Edit Employee: <%= employee.name %></h5>
      </div>
      <% if (message && message !== '') { %>
      <div class="alert alert-danger border-0 mb-4" style="border-radius:10px;"><i class="fa-solid fa-circle-exclamation me-2"></i><%= message %></div>
      <% } %>
      <div class="form-card" style="max-width:680px;">
        <form method="post" action="/admin/edit-employee/<%= employee._id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Full Name *</label>
              <input type="text" name="name" class="form-control" required value="<%= employee.name %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Email Address *</label>
              <input type="email" name="email" class="form-control" required value="<%= employee.email %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Date of Birth *</label>
              <input type="date" name="DOB" class="form-control" required value="<%= new Date(employee.dateOfBirth).toISOString().substring(0,10) %>" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Contact Number</label>
              <input type="text" name="number" class="form-control" value="<%= employee.contactNumber %>" placeholder="03XX-XXXXXXX" />
            </div>
            <div class="col-md-6">
              <label class="form-label">Department</label>
              <select name="department" class="form-select">
                <% ['N/A','Human Resource','Software Development','IT consulting','Quality Assurance','Accounts','Marketing','Business Analysis'].forEach(function(d){ %>
                <option value="<%= d %>" <%= employee.department === d ? 'selected' : '' %>><%= d %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Designation</label>
              <select name="designation" class="form-select">
                <% ['N/A','System Analyst','Accounts Manager','Project Manager','Software Engineer','Sr.Software Engineer','Project Lead','Business Analyst','Human Resource Manager','Software Developer','Quality Analyst'].forEach(function(d){ %>
                <option value="<%= d %>" <%= employee.designation === d ? 'selected' : '' %>><%= d %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Skills</label>
              <select name="skills[]" class="form-select" multiple style="height:120px;">
                <% ['Front End','ROR','.NET','PHP','Python Django (ERP)','Mobile Development','Big Data Analytics','Firmware'].forEach(function(s){ %>
                <option <%= employee.Skills && employee.Skills.indexOf(s) >= 0 ? 'selected' : '' %>><%= s %></option>
                <% }); %>
              </select>
              <div class="form-text">Hold Ctrl / Cmd to select multiple</div>
            </div>
            <div class="col-12 d-flex gap-2">
              <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Save Changes</button>
              <a href="/admin/view-all-employees" class="btn btn-outline-secondary">Cancel</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>