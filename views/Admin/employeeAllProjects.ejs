<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'projects' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Employee Projects', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="page-inner">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">Projects: <%= user.name %></h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;"><%= projects.length %> project<%= projects.length !== 1 ? 's' : '' %> assigned</p>
        </div>
        <a href="/admin/add-employee-project/<%= user._id %>" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus me-2"></i>Add Project</a>
      </div>
      <div class="section-card">
        <div class="section-card-body">
          <% if (hasProject === 1) { %>
          <table class="table table-modern dt-table mb-0">
            <thead><tr><th>Title</th><th>Type</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
              <% projects.forEach(function(item) { %>
              <tr>
                <td style="font-weight:600;"><%= item.title %></td>
                <td style="font-size:0.85rem;"><%= item.type %></td>
                <td><% if(item.status === 'Finished') { %><span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Finished</span><% } else { %><span class="badge" style="background:#EFF6FF;color:#2490EF;border-radius:20px;padding:4px 10px;">Ongoing</span><% } %></td>
                <td>
                  <a href="/admin/employee-project-info/<%= item._id %>" class="btn btn-sm btn-outline-secondary me-1" title="View"><i class="fa-solid fa-eye"></i></a>
                  <a href="/admin/edit-employee-project/<%= item._id %>" class="btn btn-sm btn-outline-primary" title="Edit"><i class="fa-solid fa-pen-to-square"></i></a>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;"><i class="fa-solid fa-diagram-project fa-3x mb-3 d-block"></i><p><%= user.name %> has no projects assigned yet.</p><a href="/admin/add-employee-project/<%= user._id %>" class="btn btn-primary btn-sm">Add First Project</a></div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>