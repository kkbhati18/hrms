<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'holidays' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Holiday Management', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>

    <div class="p-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">Holidays</h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;">Manage company-wide holidays and leave policies</p>
        </div>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addHolidayModal">
          <i class="fa-solid fa-plus me-2"></i>Add Holiday
        </button>
      </div>

      <div class="card">
        <div class="card-body">
          <% if (holidays.length > 0) { %>
          <table class="table table-hover dt-table mb-0">
            <thead>
              <tr>
                <th>Holiday Name</th>
                <th>Date</th>
                <th>Type</th>
                <th>Description</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% holidays.forEach(function(h) { %>
              <tr>
                <td style="font-weight:500;"><%= h.name %></td>
                <td><%= moment(h.date).format('DD MMM YYYY') %></td>
                <td>
                  <% const typeColors = {National:'bg-primary',Regional:'bg-info',Optional:'bg-warning',Company:'bg-success'}; %>
                  <span class="badge <%= typeColors[h.type] || 'bg-secondary' %> bg-opacity-10 text-dark" style="border-radius:20px;padding:4px 10px;">
                    <%= h.type %>
                  </span>
                </td>
                <td style="color:#6b7280;font-size:0.85rem;"><%= h.description || '—' %></td>
                <td>
                  <form method="post" action="/admin/holidays/delete/<%= h._id %>" style="display:inline;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-sm btn-outline-danger"
                      onclick="return confirm('Delete this holiday?')">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;">
            <i class="fa-solid fa-umbrella-beach fa-3x mb-3 d-block"></i>
            <p>No holidays added yet.</p>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addHolidayModal">Add First Holiday</button>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Holiday Modal -->
  <div class="modal fade" id="addHolidayModal" tabindex="-1">
    <div class="modal-dialog">
      <form method="post" action="/admin/holidays/add">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="modal-content border-0 shadow">
          <div class="modal-header border-0 pb-0">
            <h5 class="modal-title fw-700">Add Holiday</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body pt-3">
            <div class="mb-3">
              <label class="form-label">Holiday Name *</label>
              <input type="text" name="name" class="form-control" required placeholder="e.g. Republic Day" />
            </div>
            <div class="mb-3">
              <label class="form-label">Date *</label>
              <input type="date" name="date" class="form-control" required />
            </div>
            <div class="mb-3">
              <label class="form-label">Type</label>
              <select name="type" class="form-select">
                <option value="National">National</option>
                <option value="Regional">Regional</option>
                <option value="Optional">Optional</option>
                <option value="Company">Company</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control" rows="2" placeholder="Optional note..."></textarea>
            </div>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Add Holiday</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
