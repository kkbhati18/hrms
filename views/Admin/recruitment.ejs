<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'recruitment' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Recruitment', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>

    <div class="p-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">Job Openings</h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;">Manage job postings and applicants</p>
        </div>
        <a href="/admin/recruitment/new" class="btn btn-primary btn-sm">
          <i class="fa-solid fa-plus me-2"></i>Post Job
        </a>
      </div>

      <!-- Stats Row -->
      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="card p-4 h-100">
            <div class="fs-2 fw-bold lh-1"><%= jobs.length %></div>
            <div class="small text-muted mt-1">Total Postings</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card p-4 h-100">
            <div class="fs-2 fw-bold lh-1"><%= jobs.filter(j=>j.status==='Open').length %></div>
            <div class="small text-muted mt-1">Active Jobs</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card p-4 h-100">
            <div class="fs-2 fw-bold lh-1"><%= jobs.reduce((sum,j)=>sum+j.applicants.length,0) %></div>
            <div class="small text-muted mt-1">Total Applicants</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="card p-4 h-100">
            <div class="fs-2 fw-bold lh-1"><%= jobs.reduce((sum,j)=>sum+j.applicants.filter(a=>a.status==='Shortlisted').length,0) %></div>
            <div class="small text-muted mt-1">Shortlisted</div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <% if (jobs.length > 0) { %>
          <table class="table table-hover dt-table mb-0">
            <thead>
              <tr>
                <th>Job Title</th>
                <th>Department</th>
                <th>Type</th>
                <th>Openings</th>
                <th>Applicants</th>
                <th>Status</th>
                <th>Posted</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% jobs.forEach(function(j) { %>
              <tr>
                <td>
                  <a href="/admin/recruitment/<%= j._id %>" style="font-weight:600;color:#2490EF;text-decoration:none;"><%= j.title %></a>
                  <div style="font-size:0.75rem;color:#9ca3af;"><%= j.experienceRequired %> exp.</div>
                </td>
                <td style="font-size:0.85rem;"><%= j.department %></td>
                <td><span class="badge bg-secondary bg-opacity-10 text-dark" style="border-radius:20px;font-size:0.75rem;"><%= j.type %></span></td>
                <td style="text-align:center;"><%= j.openings %></td>
                <td style="text-align:center;font-weight:600;"><%= j.applicants.length %></td>
                <td>
                  <% if(j.status==='Open') { %>
                  <span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Open</span>
                  <% } else if(j.status==='Closed') { %>
                  <span class="badge" style="background:#FFF1F2;color:#F43F5E;border-radius:20px;padding:4px 10px;">Closed</span>
                  <% } else { %>
                  <span class="badge" style="background:#FFF7ED;color:#F97316;border-radius:20px;padding:4px 10px;">On Hold</span>
                  <% } %>
                </td>
                <td style="font-size:0.82rem;color:#6b7280;"><%= moment(j.postedAt).format('DD MMM YYYY') %></td>
                <td>
                  <div class="d-flex gap-1">
                    <a href="/admin/recruitment/<%= j._id %>" class="btn btn-sm btn-outline-primary" style="font-size:0.75rem;">View</a>
                    <form method="post" action="/admin/recruitment/update-status/<%= j._id %>" style="display:flex;gap:4px;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <% if(j.status !=='Closed') { %>
                      <button type="submit" name="status" value="Closed" class="btn btn-sm btn-outline-danger" style="font-size:0.75rem;">Close</button>
                      <% } else { %>
                      <button type="submit" name="status" value="Open" class="btn btn-sm btn-outline-success" style="font-size:0.75rem;">Reopen</button>
                      <% } %>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;">
            <i class="fa-solid fa-briefcase fa-3x mb-3 d-block"></i>
            <p>No job postings yet.</p>
            <a href="/admin/recruitment/new" class="btn btn-primary btn-sm">Post First Job</a>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
