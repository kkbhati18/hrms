<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>HRMS | <%= title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <!-- Font Awesome 6 -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
  <!-- DataTables Bootstrap 5 -->
  <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
  <style>
    :root {
      --sidebar-width: 260px;
      --navbar-height: 60px;
      --primary: #2490EF;
      --primary-dark: #1a6dbf;
      --sidebar-bg: #1a1f2e;
      --sidebar-text: #adb5bd;
      --sidebar-hover: rgba(255,255,255,0.08);
      --sidebar-active: rgba(36,144,239,0.18);
      --sidebar-active-border: #2490EF;
    }
    body { background: #f4f6f9; font-family: 'Segoe UI', system-ui, sans-serif; }

    /* ── Sidebar ── */
    #sidebar {
      width: var(--sidebar-width); min-height: 100vh;
      background: var(--sidebar-bg); position: fixed;
      top: 0; left: 0; transition: width 0.3s;
      z-index: 1030; overflow-y: auto; overflow-x: hidden;
    }
    #sidebar .sidebar-brand {
      height: var(--navbar-height); display: flex; align-items: center;
      padding: 0 20px; border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    #sidebar .sidebar-brand .brand-text {
      font-size: 1.2rem; font-weight: 700; color: #fff; white-space: nowrap;
    }
    #sidebar .sidebar-brand .brand-icon {
      width: 34px; height: 34px; background: var(--primary); border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      margin-right: 10px; flex-shrink: 0; color: #fff; font-size: 1rem;
    }
    .sidebar-section-title {
      font-size: 0.7rem; font-weight: 700; letter-spacing: 1.2px;
      color: rgba(255,255,255,0.3); text-transform: uppercase;
      padding: 18px 20px 6px;
    }
    .sidebar-nav .nav-item .nav-link {
      color: var(--sidebar-text); padding: 9px 20px; border-radius: 0;
      display: flex; align-items: center; gap: 12px; font-size: 0.88rem;
      border-left: 3px solid transparent; transition: all 0.2s; white-space: nowrap;
    }
    .sidebar-nav .nav-item .nav-link:hover { background: var(--sidebar-hover); color: #fff; }
    .sidebar-nav .nav-item .nav-link.active {
      background: var(--sidebar-active); color: #fff; border-left-color: var(--sidebar-active-border);
    }
    .sidebar-nav .nav-item .nav-link i { width: 18px; text-align: center; font-size: 0.9rem; }
    .sidebar-submenu { background: rgba(0,0,0,0.15); padding-left: 0; }
    .sidebar-submenu .nav-link { padding-left: 52px !important; font-size: 0.83rem; }

    /* ── Main wrapper ── */
    #main-content { margin-left: var(--sidebar-width); min-height: 100vh; transition: margin-left 0.3s; }

    /* ── Top Navbar ── */
    .top-navbar {
      height: var(--navbar-height); background: #fff; border-bottom: 1px solid #e8ecf0;
      display: flex; align-items: center; padding: 0 24px;
      position: sticky; top: 0; z-index: 1020; gap: 12px;
    }
    .top-navbar .page-title { font-size: 1rem; font-weight: 600; color: #2d3748; margin: 0; flex: 1; }
    .top-navbar .nav-btn {
      width: 38px; height: 38px; border-radius: 50%; border: none; background: #f4f6f9;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      color: #6b7280; font-size: 0.9rem; transition: background 0.2s;
    }
    .top-navbar .nav-btn:hover { background: #e8ecf0; }
    .user-avatar {
      width: 36px; height: 36px; border-radius: 50%; background: var(--primary); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 0.85rem; cursor: pointer;
    }

    /* ── Stats Cards ── */
    .stat-card {
      background: #fff; border-radius: 12px; padding: 20px 24px;
      border: 1px solid #e8ecf0; transition: box-shadow 0.2s;
    }
    .stat-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .stat-card .stat-icon {
      width: 48px; height: 48px; border-radius: 12px;
      display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
    }
    .stat-card .stat-value { font-size: 1.8rem; font-weight: 700; color: #1a202c; line-height: 1; }
    .stat-card .stat-label { font-size: 0.82rem; color: #6b7280; margin-top: 4px; }
    .stat-card .stat-change { font-size: 0.78rem; margin-top: 8px; }

    /* ── Section Cards ── */
    .section-card { background: #fff; border-radius: 12px; border: 1px solid #e8ecf0; overflow: hidden; }
    .section-card .section-card-header {
      padding: 16px 20px; border-bottom: 1px solid #f0f0f0;
      display: flex; align-items: center; justify-content: space-between;
    }
    .section-card .section-card-header h6 { font-weight: 700; font-size: 0.9rem; color: #2d3748; margin: 0; }

    /* ── Module Cards ── */
    .module-card {
      background: #fff; border-radius: 12px; padding: 20px; border: 1px solid #e8ecf0;
      text-decoration: none; display: flex; flex-direction: column; gap: 10px; transition: all 0.2s;
    }
    .module-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.1); transform: translateY(-2px); text-decoration: none; }
    .module-card .module-icon {
      width: 44px; height: 44px; border-radius: 10px;
      display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
    }
    .module-card .module-title { font-size: 0.9rem; font-weight: 600; color: #2d3748; }
    .module-card .module-desc { font-size: 0.78rem; color: #6b7280; }

    /* ── Tables ── */
    .table-modern th {
      font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px;
      color: #6b7280; font-weight: 600; background: #f8fafc; border-bottom: 1px solid #e8ecf0;
    }
    .table-modern td { font-size: 0.87rem; vertical-align: middle; }
    .table-modern tbody tr:hover { background: #fafbfc; }

    /* ── Page inner ── */
    .page-inner { padding: 24px; }

    /* ── Toast ── */
    .toast-container { position: fixed; top: 70px; right: 20px; z-index: 9999; }

    /* ── Forms ── */
    .form-card { background: #fff; border-radius: 12px; border: 1px solid #e8ecf0; padding: 28px; }
    .form-label { font-size: 0.85rem; font-weight: 600; color: #374151; }
    .form-control, .form-select { border-radius: 8px; border-color: #d1d5db; font-size: 0.88rem; }
    .form-control:focus, .form-select:focus {
      border-color: var(--primary); box-shadow: 0 0 0 3px rgba(36,144,239,0.15);
    }
    .btn-primary { background: var(--primary); border-color: var(--primary); }
    .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); }

    /* ── Profile Avatar ── */
    .profile-avatar-lg {
      width: 80px; height: 80px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), #6366f1);
      color: #fff; font-size: 2rem; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      #sidebar { width: 0; }
      #sidebar.show { width: var(--sidebar-width); }
      #main-content { margin-left: 0; }
    }
  </style>
</head>