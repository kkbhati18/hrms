<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'leaves' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Expense Claims', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>

    <div class="p-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h5 style="font-weight:700;margin:0;color:#1a202c;">Expense Claims</h5>
          <p style="color:#6b7280;font-size:0.83rem;margin:2px 0 0;">Review and approve employee expense reimbursements</p>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <% if (claims.length > 0) { %>
          <table class="table table-hover dt-table mb-0">
            <thead>
              <tr>
                <th>Employee</th>
                <th>Title</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% claims.forEach(function(item) { %>
              <% const c = item.claim; const emp = item.employee; %>
              <tr>
                <td>
                  <div style="font-weight:500;font-size:0.87rem;"><%= emp ? emp.name : 'Unknown' %></div>
                  <div style="font-size:0.75rem;color:#9ca3af;"><%= emp ? emp.department || '' : '' %></div>
                </td>
                <td style="font-weight:500;"><%= c.title %></td>
                <td>
                  <span class="badge bg-secondary bg-opacity-10 text-dark" style="border-radius:20px;font-size:0.75rem;"><%= c.category %></span>
                </td>
                <td style="font-weight:600;color:#1a202c;">₹<%= c.amount.toLocaleString() %></td>
                <td style="font-size:0.83rem;color:#6b7280;"><%= moment(c.expenseDate).format('DD MMM YYYY') %></td>
                <td>
                  <% if(c.status==='Approved') { %>
                  <span class="badge" style="background:#F0FDF4;color:#22C55E;border-radius:20px;padding:4px 10px;">Approved</span>
                  <% } else if(c.status==='Rejected') { %>
                  <span class="badge" style="background:#FFF1F2;color:#F43F5E;border-radius:20px;padding:4px 10px;">Rejected</span>
                  <% } else { %>
                  <span class="badge" style="background:#FFF7ED;color:#F97316;border-radius:20px;padding:4px 10px;">Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if(c.status === 'Pending') { %>
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reviewModal<%= c._id %>">Review</button>
                  <div class="modal fade" id="reviewModal<%= c._id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <form method="post" action="/admin/expense-claims/review/<%= c._id %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <div class="modal-content border-0 shadow">
                          <div class="modal-header border-0"><h6 class="modal-title fw-bold">Review Claim: <%= c.title %></h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                          <div class="modal-body">
                            <p style="font-size:0.85rem;color:#6b7280;"><%= c.description %></p>
                            <p style="font-weight:700;">Amount: ₹<%= c.amount.toLocaleString() %></p>
                            <div class="mb-3">
                              <label class="form-label">Decision *</label>
                              <select name="status" class="form-select" required>
                                <option value="Approved">Approve</option>
                                <option value="Rejected">Reject</option>
                              </select>
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Note</label>
                              <textarea name="reviewNote" class="form-control" rows="2" placeholder="Optional note..."></textarea>
                            </div>
                          </div>
                          <div class="modal-footer border-0">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-sm">Submit Decision</button>
                          </div>
                        </div>
                      </form>
                    </div>
                  </div>
                  <% } else { %>
                  <span style="font-size:0.78rem;color:#9ca3af;"><%= c.reviewNote || '—' %></span>
                  <% } %>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <% } else { %>
          <div class="text-center py-5" style="color:#9ca3af;">
            <i class="fa-solid fa-receipt fa-3x mb-3 d-block"></i>
            <p>No expense claims submitted yet.</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/scripts') %>
</body>
</html>
