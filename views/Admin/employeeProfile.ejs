<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header') %>
<body>
  <%- include('../partials/sidebar_admin', { activePage: 'employees' }) %>
  <div id="main-content">
    <%- include('../partials/navbar', { pageTitle: 'Employee Profile', userName, csrfToken, profileUrl: '/admin/view-profile', userRole: 'Administrator' }) %>
    <div class="page-inner">
      <div class="mb-4">
        <a href="/admin/view-all-employees" class="btn btn-outline-secondary btn-sm me-2"><i class="fa-solid fa-arrow-left me-1"></i>Back</a>
        <h5 class="d-inline-block ms-1" style="font-weight:700;color:#1a202c;">Employee Profile</h5>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="section-card text-center">
            <div class="section-card-body">
              <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#2490EF,#1976D2);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.8rem;font-weight:700;margin:0 auto 1rem;"><%= employee.name ? employee.name[0].toUpperCase() : 'E' %></div>
              <h6 style="font-weight:700;margin:0;"><%= employee.name %></h6>
              <p style="color:#6b7280;font-size:0.85rem;margin:4px 0 8px;"><%= employee.designation || 'N/A' %></p>
              <span class="badge" style="background:#EFF6FF;color:#2490EF;border-radius:20px;font-size:0.75rem;padding:5px 12px;"><%= employee.department || 'N/A' %></span>
              <div class="d-flex gap-2 justify-content-center mt-3">
                <a href="/admin/edit-employee/<%= employee._id %>" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-pen-to-square me-1"></i>Edit</a>
                <a href="/admin/view-employee-attendance/<%= employee._id %>" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-calendar-check me-1"></i>Attendance</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-8">
          <div class="section-card">
            <div class="section-card-body">
              <h6 style="font-weight:700;margin-bottom:1rem;color:#374151;">Personal Information</h6>
              <div class="row g-3">
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Email</div><div style="font-weight:600;word-break:break-all;"><%= employee.email %></div></div>
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Contact</div><div style="font-weight:600;"><%= employee.contactNumber || 'N/A' %></div></div>
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Date of Birth</div><div style="font-weight:600;"><%= moment(employee.dateOfBirth).format('DD MMM YYYY') %></div></div>
                <div class="col-sm-6"><div style="font-size:0.78rem;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;">Role</div><div style="font-weight:600;"><%= employee.type %></div></div>
              </div>
              <% if(employee.Skills && employee.Skills.length > 0) { %>
              <hr style="margin:1.5rem 0;" />
              <h6 style="font-weight:700;margin-bottom:0.75rem;color:#374151;">Skills</h6>
              <div class="d-flex flex-wrap gap-2">
                <% employee.Skills.forEach(function(s){ if(s){ %><span class="badge" style="background:#EFF6FF;color:#2490EF;border-radius:20px;font-size:0.8rem;padding:5px 12px;"><%= s %></span><% } }); %>
              </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>